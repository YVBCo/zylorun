# Database Configuration (Supports SQLite and PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./sql_app.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql+asyncpg://passport_user:secure_password@db:5432/risk_passport

# Security & Session Authentication
SECRET_KEY=change_this_to_a_cryptographically_secure_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development

# GitHub Integration & OAuth (Optional, for GitHub Repository Sync)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_key
GITHUB_TOKEN_ENCRYPTION_KEY=uE2N2wF5bCq-H6sVlqQhM5mZl3fA7xP4V2bJ0rA1h10=

# AI Provider Configuration (Optional, for AI Fix Assistance)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
# Or OpenAI:
# AI_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here

# Frontend Application Origin
FRONTEND_URL=http://localhost:5173
