# Database Configuration (Supports SQLite and PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./sql_app.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql+asyncpg://passport_user:secure_password@db:5432/risk_passport

# Security & Session Authentication
SECRET_KEY=""
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development

# GitHub Integration & OAuth (Optional, for GitHub Repository Sync)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_WEBHOOK_SECRET=""
GITHUB_TOKEN_ENCRYPTION_KEY=""

# AI Provider Configuration (Optional, for AI Fix Assistance)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
# Or OpenAI:
# AI_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here

# Frontend Application Origin
FRONTEND_URL=http://localhost:5173
